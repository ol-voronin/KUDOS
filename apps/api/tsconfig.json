{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    // DOM тут не заради браузера, а заради глобального fetch: типи Response
    // із @types/node приходять через undici-types, і в збірці на Vercel вони
    // не розвʼязуються — Response стає порожнім інтерфейсом, і кожен res.ok
    // валить білд. lib.dom описує ті самі Response/Headers однозначно.
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
