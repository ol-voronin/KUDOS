// Doggie Tale — catalogue and orders.
//
// Money: every *Minor field is an INTEGER number of kopiykas. There is no
// Decimal and no Float anywhere in this schema, deliberately.
//
// The product model is five levels deep, which is one more than a normal shop:
//   Line -> Garment (type + fit) -> Fabric -> Colour -> Size
// The extra level is Fabric, because own-production sweatshirts can be sewn
// from either тринитка петля or тринитка з начісом and each has its own palette.

generator client {
  provider = "prisma-client-js"
  /// `native` — для macOS розробника. `rhel-openssl-3.0.x` — для Vercel
  /// (Amazon Linux 2023). Без другого рядка клієнт збереться локально й
  /// впаде в проді з «query engine binary not found» уже під час запиту.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  /// Пул зʼєднань (PgBouncer у Neon). Через нього ходить застосунок.
  url      = env("DATABASE_URL")
  /// Пряме зʼєднання. Міграції через пул не працюють: PgBouncer у режимі
  /// transaction не тримає сесійні блокування, на які спирається migrate.
  /// Локально обидві змінні вказують на ту саму базу — і це нормально.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — mirrored in @dt/contracts. Keep both in sync; the contracts package
// is what the frontend sees, this is what the database enforces.
// ---------------------------------------------------------------------------

enum ProductLine {
  OWN_PRODUCTION
  NATIVE_SPIRIT
}

enum GarmentFit {
  CLASSIC
  OVERSIZE
  OVERSIZE_WOMEN
  COMFORT
  HYBRID
  KIDS
}

enum GarmentType {
  TSHIRT
  SWEATSHIRT
  HOODIE
  ZIP_HOODIE
  JOGGERS
  TOTE_BAG
}

enum VariantAvailability {
  IN_STOCK
  MADE_TO_ORDER
  UNAVAILABLE
}

enum PrintSizeTier {
  MINI
  MEDIUM
  MAXI
}

enum PrintMethod {
  DTF
  DTG
}

/// Куди їде замовлення. Тільки Нова Пошта плюс самовивіз: інших перевізників
/// ми не використовуємо, а порожній пункт у переліку читається як обіцянка.
enum DeliveryMethod {
  NP_BRANCH
  NP_POSTOMAT
  NP_COURIER
  PICKUP
}

enum OrderStream {
  READY_PRINT
  CUSTOMISATION
  FROM_ZERO
}

enum OrderStatus {
  /// Замовлення прийняте, рахунок ще не виставлений. Між ним і оплатою
  /// стоїть людина: звіряємо наявність, пишемо покупцеві, потім рахунок.
  NEW
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  SHIPPED
  COMPLETED
  CANCELLED
}

enum CustomRequestStatus {
  SUBMITTED
  QUOTED
  DEPOSIT_PAID
  IN_DESIGN
  AWAITING_APPROVAL
  APPROVED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

/// Mirrors Monobank's invoice status field exactly — there is no reason to
/// invent a parallel vocabulary for the same seven states.
enum PaymentStatus {
  CREATED
  PROCESSING
  HOLD
  SUCCESS
  FAILURE
  REVERSED
  EXPIRED
}

/// DEBIT charges the card immediately at invoice creation. HOLD blocks the
/// funds without capturing them — capture only happens on an explicit
/// `finalize` call (see `PaymentsAdminService`).
enum PaymentType {
  DEBIT
  HOLD
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

/// Мова вмісту. Значення поки одне — див. коментар у контрактах: колонка
/// існує з першого дня саме для того, щоб друга мова не стала міграцією.
enum Locale {
  UK
}

/// OWNER може все, включно з видаленням сайту. EDITOR — вміст і публікація.
/// Двох ролей вистачає надовго: третю додають тоді, коли зʼявляється людина,
/// якій треба менше за EDITOR, а не тому що «хай буде».
enum SiteRole {
  OWNER
  EDITOR
}

enum PageKind {
  PAGE
  ARTICLE
  SYSTEM
}

enum PageVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MeasurementKey {
  WIDTH
  LENGTH
  SLEEVE
  WAIST
  HIP
}

// ---------------------------------------------------------------------------
// Catalogue — garment side
// ---------------------------------------------------------------------------

model Fabric {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  line        ProductLine
  /// g/m². A single number. The source sheets disagree (320-340 vs 330) —
  /// resolve that once, here, not on every page that renders it.
  weightGsm   Int
  composition String
  origin      String?

  garments  GarmentFabric[]
  colours   FabricColour[]
  variants  Variant[]
  modifiers PriceModifier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([line, name])
  @@index([line])
}

model Colour {
  id           String  @id @default(uuid()) @db.Uuid
  /// Native Spirit colours have real names. Own-production colours are known
  /// only by a number on a physical swatch card — this is nullable until
  /// somebody names them.
  name         String?
  /// The supplier's identifier: "38", "Aquamarine". Always present.
  supplierCode String
  /// #RRGGBB. Null means "not digitised yet" and the UI must fall back to a
  /// photo rather than rendering a wrong swatch.
  hex          String? @db.Char(7)
  imageUrl     String?

  fabrics   FabricColour[]
  variants  Variant[]
  modifiers PriceModifier[]
  printExclusions PrintColourExclusion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierCode])
  @@index([name])
}

/// A colour exists only in the fabrics that are actually woven in it.
model FabricColour {
  fabricId String @db.Uuid
  colourId String @db.Uuid

  fabric Fabric @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  colour Colour @relation(fields: [colourId], references: [id], onDelete: Cascade)

  @@id([fabricId, colourId])
  @@index([colourId])
}

model Garment {
  id   String      @id @default(uuid()) @db.Uuid
  slug String      @unique
  line ProductLine
  type GarmentType
  fit  GarmentFit
  name String

  /// Own production can shorten the item to fit the person. No blank can.
  /// This is a selling point, not a footnote — it belongs in the data.
  lengthAdjustable Boolean @default(false)

  /// Короткий опис із паспорта виробу: крій, кому пасує. Порожній рядок —
  /// припустимо; сторінка просто не малює абзац.
  description String @default("")

  basePriceMinor Int
  isPublished    Boolean @default(false)

  fabrics  GarmentFabric[]
  sizes    Size[]
  variants Variant[]
  rules    PrintGarmentRule[]
  exclusions PrintGarmentExclusion[]
  modifiers  PriceModifier[]
  discounts  Discount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per real product. "Класична футболка" exists twice — once per
  /// line — and that is correct; they are different garments.
  @@unique([line, type, fit])
  @@index([line, type])
  @@index([isPublished])
}

model GarmentFabric {
  garmentId String @db.Uuid
  fabricId  String @db.Uuid
  /// Own production lets the buyer pick петля or начіс. Native Spirit does not.
  isDefault Boolean @default(false)

  garment Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  fabric  Fabric  @relation(fields: [fabricId], references: [id], onDelete: Cascade)

  @@id([garmentId, fabricId])
  @@index([fabricId])
}

/// Sizes belong to a garment, not to the shop. There are nine different size
/// schemas across the range (XS-3XL, XS/S-XL/2XL, S/M-L/XL, XXS-XXL, 98-152...)
/// and no universal selector will work.
model Size {
  id        String @id @default(uuid()) @db.Uuid
  garmentId String @db.Uuid
  /// Exactly as printed on the chart: "XS", "XS/S", "116", "98-104".
  label     String
  position  Int

  garment      Garment       @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  measurements Measurement[]
  variants     Variant[]

  @@unique([garmentId, label])
  @@unique([garmentId, position])
  @@index([garmentId])
}

/// Measurement rows differ per garment: width+length, or +sleeve, or
/// waist+hip+length. Modelled as rows rather than columns for that reason.
model Measurement {
  id     String         @id @default(uuid()) @db.Uuid
  sizeId String         @db.Uuid
  key    MeasurementKey
  /// String, because real charts contain ranges: "66-76", "95.5".
  value  String

  size Size @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([sizeId, key])
}

/// The sellable blank: one garment, in one fabric, one colour, one size.
model Variant {
  id        String @id @default(uuid()) @db.Uuid
  sku       String @unique
  garmentId String @db.Uuid
  fabricId  String @db.Uuid
  colourId  String @db.Uuid
  sizeId    String @db.Uuid

  availability VariantAvailability @default(UNAVAILABLE)
  /// MUST be set when availability = MADE_TO_ORDER. Enforced by a CHECK
  /// constraint added in the migration — application validation is not enough.
  leadTimeDays Int?
  /// Only when this variant costs more than the garment's base price.
  priceOverrideMinor Int?

  garment Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  fabric  Fabric  @relation(fields: [fabricId], references: [id])
  colour  Colour  @relation(fields: [colourId], references: [id])
  size    Size    @relation(fields: [sizeId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garmentId, fabricId, colourId, sizeId])
  @@index([garmentId, availability])
  @@index([availability])
}

// ---------------------------------------------------------------------------
// Catalogue — artwork side
// ---------------------------------------------------------------------------

model Collection {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  title       String
  description String?
  position    Int     @default(0)
  isPublished Boolean @default(false)

  prints    PrintCollection[]
  rules     PrintGarmentRule[]
  discounts Discount[]
  articles  PageCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, position])
}

/// The long-tail SEO axis. "футболка з коргі" is a query with intent;
/// "принт на футболку" is not.
model Breed {
  id       String  @id @default(uuid()) @db.Uuid
  slug     String  @unique
  name     String
  /// коргі / вельш-коргі / corgi — all point at the same breed page.
  synonyms String[]

  prints   PrintBreed[]
  articles PageBreed[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Print {
  id         String        @id @default(uuid()) @db.Uuid
  slug       String        @unique
  title      String
  sizeTier   PrintSizeTier
  /// Обкладинка. Заповнюється автоматично з першого фото — див. PrintImage.
  previewUrl String        @default("")
  /// Production artwork location. Never exposed through the public API.
  artworkKey String
  /// Вебмакет для авто-мокапів: PNG із прозорим тлом, лягає поверх фото
  /// виробу на сторінці товару. Порожній рядок — мокапи не малюються, і це
  /// нормальний стан: сторінка показує те, що показувала завжди.
  mockupUrl  String @default("")

  isPublished Boolean @default(false)

  collections PrintCollection[]
  breeds      PrintBreed[]
  orderItems  OrderItem[]
  images      PrintImage[]
  exclusions  PrintGarmentExclusion[]
  colourExclusions PrintColourExclusion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@index([sizeTier])
}

/// Фотографії принта на виробі. До пʼяти на принт.
///
/// Обмеження «не більше пʼяти» тримає сервіс, а не база: CHECK не вміє
/// рахувати рядки в іншій таблиці, а тригер заради цього — надто дорого для
/// правила, яке міняється разом із дизайном картки.
///
/// `previewUrl` у Print лишається обкладинкою й дублює url першого фото
/// навмисно: усі читальні шляхи каталогу вже беруть його одним полем без
/// join-а, а картка товару рендериться в чотирьох різних сітках.
model PrintImage {
  id      String @id @default(uuid()) @db.Uuid
  printId String @db.Uuid
  print   Print  @relation(fields: [printId], references: [id], onDelete: Cascade)

  url String
  /// Ключ у сховищі. Без нього рядок можна видалити, а файл лишиться назавжди.
  pathname String
  alt      String @default("")
  position Int    @default(0)

  createdAt DateTime @default(now())

  @@index([printId, position])
}

model PrintCollection {
  printId      String @db.Uuid
  collectionId String @db.Uuid

  print      Print      @relation(fields: [printId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([printId, collectionId])
  @@index([collectionId])
}

model PrintBreed {
  printId String @db.Uuid
  breedId String @db.Uuid

  print Print @relation(fields: [printId], references: [id], onDelete: Cascade)
  breed Breed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  @@id([printId, breedId])
  @@index([breedId])
}

/// Обмеження «портрети — тільки оверсайз», записане як дані, а не як правило
/// в чиїйсь голові.
///
/// ВАЖЛИВО про семантику. Раніше правило читалося так: «виріб пропонується,
/// лише якщо він явно дозволений колекцією». Наслідок — принт без колекції
/// не продавався взагалі, і сторінка товару виглядала зламаною при
/// цілком коректних даних. Тепер правило звужує вибір лише тоді, коли воно
/// є: колекція без жодного рядка тут не обмежує нічого, а принт без
/// колекції друкується на всьому опублікованому асортименті. Заборони —
/// у `PrintGarmentExclusion`.
model PrintGarmentRule {
  id           String @id @default(uuid()) @db.Uuid
  collectionId String @db.Uuid
  garmentId    String @db.Uuid

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  garment    Garment    @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([collectionId, garmentId])
  @@index([garmentId])
}

/// Точкова заборона: цей принт не друкуємо на цьому виробі.
///
/// Живе на принті, а не на колекції, бо причина завжди конкретна — макет
/// не лізе в поле друку саме цієї моделі. Колекційне правило такого не
/// висловлює: воно про цілий жанр.
model PrintGarmentExclusion {
  printId   String @db.Uuid
  garmentId String @db.Uuid
  /// Для адмінки: чому заборонено. Порожній рядок припустимий.
  reason    String @default("")

  print   Print   @relation(fields: [printId], references: [id], onDelete: Cascade)
  garment Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([printId, garmentId])
  @@index([garmentId])
}

/// Точкова заборона: цей принт не друкуємо на цьому кольорі.
///
/// Той самий принцип, що й у PrintGarmentExclusion: за замовчуванням принт
/// існує в усіх кольорах виробу, а заборона — виняток із причиною.
/// «Песи в барі» темні й тонуть на оранжевому — це рішення про конкретну
/// пару принт×колір, і жити воно має в даних, а не в голові.
model PrintColourExclusion {
  printId  String @db.Uuid
  colourId String @db.Uuid
  /// Для адмінки: чому заборонено. Порожній рядок припустимий.
  reason   String @default("")

  print  Print  @relation(fields: [printId], references: [id], onDelete: Cascade)
  colour Colour @relation(fields: [colourId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([printId, colourId])
  @@index([colourId])
}

/// Куди дивиться надбавка: на розмір, на тканину або на колір.
///
/// Розмір ідентифікується написом («2XL»), а не рядком у таблиці Size: сітки
/// в нас девʼять різних, і «2XL» — це девʼять різних записів. Правило «великі
/// розміри дорожчі» стосується напису, а не конкретного виробу, тож і
/// зберігається за написом.
enum PriceModifierTarget {
  SIZE_LABEL
  FABRIC
  COLOUR
}

/// Як рахується сума: у копійках чи у відсотках від базової ціни.
enum PriceAdjustKind {
  DELTA
  PERCENT
}

/// На що діє знижка.
enum DiscountScope {
  ALL
  GARMENT
  COLLECTION
}

/// Надбавка до ціни виробу.
///
/// Чому це правила, а не ціна в кожному варіанті: варіантів 7 виробів × 4
/// тканини × 23 кольори × 8 розмірів. Проставити ціну в кожному — це тисячі
/// рядків, які ніхто ніколи не перевірить. Правил натомість одиниці, і кожне
/// читається вголос: «2XL +50 ₴», «начіс +30 ₴».
///
/// Ручна ціна варіанта (`Variant.priceOverrideMinor`) нікуди не поділася й
/// має вищий пріоритет: правила описують систему, override — виняток із неї.
model PriceModifier {
  id     String              @id @default(uuid()) @db.Uuid
  /// Назва для адмінки: «Великі розміри», «Начіс».
  name   String
  target PriceModifierTarget

  /// Заповнена рівно одна з трьох — відповідно до `target`. Стежить CHECK у міграції.
  sizeLabel String?
  fabricId  String? @db.Uuid
  colourId  String? @db.Uuid

  /// Звуження до одного виробу. NULL — правило діє на весь асортимент.
  garmentId String? @db.Uuid

  kind PriceAdjustKind @default(DELTA)
  /// DELTA — копійки (відʼємне значення = знижка). PERCENT — соті відсотка:
  /// 1000 = 10 %. Одна колонка, бо два види ніколи не діють одночасно.
  amount Int

  isActive Boolean @default(true)

  fabric  Fabric?  @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  colour  Colour?  @relation(fields: [colourId], references: [id], onDelete: Cascade)
  garment Garment? @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([garmentId])
  @@index([fabricId])
  @@index([colourId])
}

/// Знижка на позицію замовлення.
///
/// Відрізняється від надбавки не сумою, а моментом: надбавка формує ціну
/// виробу, знижка застосовується до вже порахованого рядка. Тому опт («від
/// 10 шт») і акція («−15 % до 31 грудня») — це одна сутність із двома
/// умовами, а не два механізми.
///
/// Знижки НЕ складаються: діє одна, найвигідніша для покупця. Складання
/// відсотків — найкоротший шлях продати за 0 ₴ через дві акції, які нікому
/// не спадало на думку перевірити разом.
model Discount {
  id    String        @id @default(uuid()) @db.Uuid
  name  String
  scope DiscountScope @default(ALL)

  /// Заповнене відповідно до `scope`. Стежить CHECK у міграції.
  garmentId    String? @db.Uuid
  collectionId String? @db.Uuid

  kind PriceAdjustKind @default(PERCENT)
  /// Розмір знижки, завжди додатний. DELTA — копійки з одиниці товару,
  /// PERCENT — соті відсотка.
  amount Int

  /// Від якої кількості в рядку діє. 1 — діє завжди.
  minQty Int @default(1)

  /// Вікно дії. NULL з обох боків — безстроково.
  startsAt DateTime?
  endsAt   DateTime?

  isActive Boolean @default(true)

  garment    Garment?    @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([garmentId])
  @@index([collectionId])
}

/// Print price by tier. A row, not a constant, so the workshop can reprice
/// without a deploy.
model PrintPrice {
  tier       PrintSizeTier @id
  priceMinor Int
  /// Discount when the customer brings finished artwork. Custom stream only.
  suppliedArtworkDiscountMinor Int @default(15000)

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Сайти — межа орендаря
// ---------------------------------------------------------------------------

/// Один сайт в установці. Сьогодні він один; завтра їх буде стільки, скільки
/// клієнтів, і всі в цій самій базі.
///
/// Саме тому `siteId` зʼявляється зараз, а не «коли знадобиться»: додати
/// колонку в чотири таблиці коштує день, а в тридцять, із перевіркою сотні
/// запитів, — тиждень, у якому кожна пропущена перевірка означає, що один
/// клієнт побачив дані іншого.
model Site {
  id   String @id @default(uuid()) @db.Uuid
  /// Технічна назва для адміністратора установки.
  key  String @unique
  name String

  /// Домени, за якими цей сайт відповідає. Порожньо — сайт доступний лише
  /// тоді, коли він в установці єдиний.
  hosts String[]

  /// Увімкнені модулі: `content` є завжди, `shop` — там, де є що продавати.
  /// Каталог, ціни й замовлення показуються в адмінці лише за наявності `shop`.
  modules String[] @default(["content"])

  isActive Boolean @default(true)

  pages   Page[]
  media   MediaAsset[]
  redirects Redirect[]
  versions  PageVersion[]
  members   SiteMember[]
  pageBreeds     PageBreed[]
  pageCollections PageCollection[]
  settings   SiteSettings?
  menu       MenuItem[]
  events      AnalyticsEvent[]
  conversions ConversionAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Доступ людини до сайту. Людина існує окремо від доступу: та сама пошта
/// може вести два сайти з різними ролями, і видалення сайту не має стирати
/// людину.
model SiteMember {
  siteId String   @db.Uuid
  userId String   @db.Uuid
  role   SiteRole @default(EDITOR)

  site Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([siteId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Вміст — сторінки, матеріали, блоки
// ---------------------------------------------------------------------------

/// Сторінка — це адреса й тип. Усе, що на ній написано, лежить у версіях.
///
/// Розділення не косметичне. Поки редактор править сторінку, у базі мусить
/// водночас існувати те, що бачать люди, і те, що ще пишеться. Якби блоки
/// були рядками зі статусом, публікація означала б оновити двадцять рядків
/// одночасно, і між першим і двадцятим відвідувач упіймав би сторінку
/// наполовину зміненою. Тут публікація — це один UPDATE статусу версії.
model Page {
  id     String   @id @default(uuid()) @db.Uuid
  siteId String   @db.Uuid
  site   Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  kind   PageKind @default(PAGE)
  locale Locale   @default(UK)
  slug   String

  /// Системну сторінку не можна видалити й не можна перейменувати: на
  /// `/oferta` посилається Monobank, на `/pryvatnist` — закон, на головну —
  /// код. Прапорець ставить сідер, адмінка його не показує.
  isSystem Boolean @default(false)

  /// Момент першої публікації. Дата матеріалу в стрічці береться звідси,
  /// а не з `createdAt`: чернетку можуть писати два тижні.
  publishedAt DateTime?
  position    Int       @default(0)

  /// Коли сайт востаннє перечитав цю сторінку після публікації, і що пішло
  /// не так, якщо пішло.
  ///
  /// Публікація змінює базу миттєво, але сторінку віддає кеш Next — і поки
  /// йому не сказати «перечитай», людина бачить старе. Мовчазна помилка тут
  /// читається як «CMS не працює», тож стан скидання кешу — це дані, які
  /// адмінка показує поруч зі сторінкою, а не рядок у логах Vercel.
  revalidatedAt   DateTime?
  revalidateError String    @default("")

  versions    PageVersion[]
  breeds      PageBreed[]
  collections PageCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Адреса унікальна в межах сайту, а не всесвіту: у двох клієнтів цілком
  /// може бути своя «Доставка».
  @@unique([siteId, locale, slug])
  @@index([siteId, kind, publishedAt])
}

/// Знімок сторінки цілком. `blocks` — масив, перевірений тим самим zod-union,
/// що й форма в адмінці.
///
/// Обмеження «одна чернетка й одна опублікована версія на сторінку» тримають
/// часткові унікальні індекси в міграції, а не код. Prisma їх не вміє
/// описати, тому вони написані руками — так само, як CHECK на leadTimeDays.
model PageVersion {
  id     String            @id @default(uuid()) @db.Uuid
  /// Дублює `page.siteId` навмисно. Без цього запит на версію за її id
  /// довелося б щоразу вести через сторінку, і рано чи пізно хтось цього не
  /// зробить. Колонка обовʼязкова й без значення за замовчуванням — тоді
  /// вкладене створення без неї не компілюється.
  siteId String            @db.Uuid
  site   Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pageId String            @db.Uuid
  page   Page              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  number Int
  status PageVersionStatus @default(DRAFT)

  title          String
  excerpt        String  @default("")
  coverUrl       String  @default("")
  seoTitle       String  @default("")
  seoDescription String  @default("")
  noindex        Boolean @default(false)

  blocks Json
  /// Покоління схеми блоків. Коли поле в блоці перейменується, це буде
  /// міграція, яку можна написати, а не археологія по JSON.
  schemaVersion Int @default(1)

  authorId String?    @db.Uuid
  author   AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Що змінено — рядок від автора, видно в історії.
  note String @default("")

  createdAt DateTime @default(now())

  @@unique([pageId, number])
  @@index([pageId, status])
  @@index([siteId])
}

enum MenuArea {
  HEADER
  FOOTER
}

/// Реквізити, контакти й дрібні числа сайту.
///
/// Досі це був файл `config/site.ts` у вебі. Для одного сайту так і треба
/// було; для установки, у якій сайтів багато, константа в коді означає, що
/// другий клієнт неможливий без деплою.
///
/// Ці ж значення підставляються в тексти через `{{brand}}`, `{{email}}`,
/// `{{cityIn}}` — і саме тому вони мусять жити в одному місці. Реквізити
/// ФОП в офері та в футері, набрані руками двічі, розходяться не одразу, а
/// тоді, коли зміниться телефон і хтось згадає про футер, але не про
/// пункт 1.2 договору.
model SiteSettings {
  siteId String @id @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  brand String

  /// Сторона договору в офері. Без цього оферта юридично порожня.
  legalEntityName  String @default("")
  legalEntityShort String @default("")
  /// РНОКПП, 10 цифр. ЄДРПОУ юросіб сюди не пишеться.
  taxNumber        String @default("")

  phone        String @default("")
  /// Той самий номер у людському вигляді: «+380 50 864 63 55».
  phoneDisplay String @default("")
  telegram     String @default("")
  telegramUrl  String @default("")
  /// Пошта для звернень щодо персональних даних. Telegram тут не рахується:
  /// політика зобовʼязана дати канал, на який можна написати офіційно.
  email        String @default("")

  city         String @default("")
  /// Місцевий відмінок із прийменником: «шиємо у Харкові».
  cityIn       String @default("")
  workingHours String @default("")

  /// Безкоштовна доставка від цієї суми, у копійках.
  freeShippingFromMinor Int @default(0)
  /// Скільки днів на повернення виробу з каталогу.
  returnDays            Int @default(14)

  /// Строк виготовлення в РОБОЧИХ днях. Обіцянка, що стоїть на головній,
  /// у картці товару й у листуванні, — тому дані, а не константа в коді.
  ///
  /// Урок, оплачений продом: колонки зʼявилися міграцією, а в цій моделі їх
  /// забули — і клієнт Prisma, який генерується САМЕ ЗІ СХЕМИ, валив кожен
  /// select налаштувань 500-ю, хоча база була в порядку. Міграція і модель
  /// їдуть тільки разом.
  productionDaysMin     Int @default(4)
  productionDaysMax     Int @default(7)

  /// Картинка для превʼю в месенджерах, коли у сторінки немає своєї.
  /// Порожньо — превʼю буде без картинки, і це краще за чужу картинку.
  defaultOgImage String @default("")

  /// Код підтвердження власності для Google Search Console.
  ///
  /// Тільки значення `content`, без тега. Тег зі стороннім вмістом у
  /// налаштуваннях — це вставка довільного HTML у `<head>` кожної сторінки,
  /// тобто рівно те, чого ми уникаємо в блоках.
  googleSiteVerification String @default("")

  /// Ідентифікатор потоку GA4: G-XXXXXXX. Порожньо — скрипт не вантажиться.
  ga4MeasurementId String @default("")
  /// Ідентифікатор конверсій Google Ads: AW-XXXXXXXXX.
  googleAdsId      String @default("")

  /// Головний вимикач індексації.
  ///
  /// Потрібен не «про всяк випадок»: доки сайт живе на *.vercel.app, він
  /// однаково `noindex` — і момент, коли зʼявиться домен, має бути свідомою
  /// дією тут, а не побічним ефектом деплою. Він же рятує від того, щоб
  /// тестовий сайт другого клієнта потрапив у пошук.
  allowIndexing Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Пункт меню — у шапці або в футері.
///
/// Таблиця, а не масив у налаштуваннях: пункти переставляють, вимикають на
/// час і додають частіше, ніж змінюють телефон. Порядок як число — щоб
/// «підняти вище» не означало переписати весь список.
model MenuItem {
  id     String   @id @default(uuid()) @db.Uuid
  siteId String   @db.Uuid
  site   Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  area   MenuArea

  /// Колонка футера: «Каталог», «Компанія». У шапці порожній рядок.
  group    String  @default("")
  label    String
  href     String
  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, area, position])
}

/// Подія на сайті.
///
/// Своя таблиця, а не тільки GA4, і причина проста: GA4 — це чужа система,
/// яка семплює дані, ховає деталі за порогами й може бути заблокована в
/// половини відвідувачів розширенням. Власні цифри мають бути власними.
///
/// Персональних даних тут немає навмисно: ні IP, ні User-Agent, ні імені.
/// `sessionId` — випадкове число на один візит, воно не ідентифікує людину
/// й не переживає закриття вкладки. Саме тому для цієї таблиці не потрібен
/// банер згоди: збирати нічого, що дозволяє когось упізнати.
model AnalyticsEvent {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// page_view, lead_submitted, checkout_started, purchase, telegram_click.
  name String
  path String

  /// Випадковий ідентифікатор візиту. Не людини.
  sessionId String

  /// Звідки прийшли. Зберігається як домен, без шляху: повний referrer
  /// інколи містить пошуковий запит, а це вже дані людини.
  referrerHost String @default("")

  utmSource   String @default("")
  utmMedium   String @default("")
  utmCampaign String @default("")
  utmTerm     String @default("")
  utmContent  String @default("")
  gclid       String @default("")

  /// Для purchase — сума замовлення в копійках.
  valueMinor Int?

  createdAt DateTime @default(now())

  @@index([siteId, name, createdAt])
  @@index([siteId, createdAt])
  @@index([siteId, utmCampaign])
}

/// Дія-конверсія в Google Ads.
///
/// Таблиця, а не чотири поля в налаштуваннях: конверсії додають і вимикають
/// частіше, ніж змінюють телефон, і кожна нова інакше означала б міграцію.
model ConversionAction {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  /// Ім'я події, на яку спрацьовує: те саме, що в AnalyticsEvent.
  event String
  /// Мітка з Google Ads — друга частина `AW-123/AbCdEf`.
  label String
  /// Чи передавати суму. Для заявки суми немає, для оплати є.
  sendValue Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, event])
}

/// Матеріал ↔ порода.
///
/// Стаття «Як доглядати вовну коргі» має стояти на сторінці коргі, а не
/// губитися в стрічці за датою. Це і є та причина, чому блог тут узагалі
/// потрібен: він не «новини», а довгий хвіст запитів, які приводять на
/// породні сторінки.
///
/// `siteId` дублює `page.siteId` — з тієї самої причини, що й у `PageVersion`:
/// без нього запит «усі матеріали про цю породу» довелося б щоразу вести
/// через сторінку, і рано чи пізно хтось цього не зробить.
model PageBreed {
  siteId  String @db.Uuid
  pageId  String @db.Uuid
  breedId String @db.Uuid

  site  Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  page  Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  breed Breed @relation(fields: [breedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([pageId, breedId])
  @@index([siteId, breedId])
}

/// Матеріал ↔ колекція. Те саме, але для жанру, а не для породи.
model PageCollection {
  siteId       String @db.Uuid
  pageId       String @db.Uuid
  collectionId String @db.Uuid

  site       Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  page       Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([pageId, collectionId])
  @@index([siteId, collectionId])
}

/// Картинка у сховищі.
///
/// Таблиця потрібна не для того, щоб «зберігати файли» — файли лежать у
/// Vercel Blob. Вона потрібна, щоб та сама картинка не заливалася вдесяте:
/// без реєстру єдиний спосіб поставити фото у два блоки — завантажити його
/// двічі, і потім вони житимуть як два різні файли з двома різними описами.
///
/// `pathname` окремо від `url` — без нього рядок можна видалити, а файл
/// лишиться у сховищі назавжди.
model MediaAsset {
  id       String @id @default(uuid()) @db.Uuid
  siteId   String @db.Uuid
  site     Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url      String
  pathname String
  filename String
  mimeType String
  bytes    Int
  /// Опис для тих, хто не бачить картинку. Заповнюється в медіатеці один
  /// раз і підставляється всюди, де картинку вставили.
  alt String @default("")

  uploadedById String?    @db.Uuid
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([siteId, pathname])
  @@index([siteId, createdAt])
}

/// Стара адреса → нова. Створюється автоматично при перейменуванні сторінки.
///
/// Без цього перейменування slug стирає все, що пошук знав про сторінку, і
/// кожне посилання на неї з чужого сайту стає 404. Запис вічний: посилання
/// в чиємусь дописі трирічної давнини має вести куди треба й через три роки.
model Redirect {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @db.Uuid
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  locale Locale @default(UK)
  /// Без початкового слеша — той самий вигляд, що й `Page.slug`.
  fromSlug String
  toSlug   String

  createdAt DateTime @default(now())

  @@unique([siteId, locale, fromSlug])
  @@index([siteId, toSlug])
}

// ---------------------------------------------------------------------------
// Orders — the cart stream
// ---------------------------------------------------------------------------

/// База номерів. Один запис на телефон — сюди зводяться всі заявки,
/// замовлення й брифи від однієї людини.
model Customer {
  id        String  @id @default(uuid()) @db.Uuid
  email     String? @unique
  phone     String  @unique
  name      String

  /// Явна згода на подальшу комунікацію. За замовчуванням false:
  /// залишена заявка — це згода на відповідь щодо неї, не на розсилку.
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?

  orders         Order[]
  customRequests CustomRequest[]
  leads          Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id         String      @id @default(uuid()) @db.Uuid
  /// Continues the numbering that already runs from #1 (9 September 2025).
  /// It is the external counter the playbook insists on keeping — do not let
  /// an analytics platform become the source of truth for order count.
  number     Int         @unique @default(autoincrement())
  customerId String      @db.Uuid
  stream     OrderStream
  status     OrderStatus @default(PENDING_PAYMENT)

  /// Snapshot totals. Recomputing an old order from current prices is a bug.
  subtotalMinor Int
  shippingMinor Int @default(0)
  discountMinor Int @default(0)
  /// Яка саме знижка спрацювала, назвою на момент замовлення. Знімок, як і
  /// суми: правило потім перейменують або вимкнуть, а питання «чому тут
  /// −15 %» ставлять через півроку.
  discountName  String?
  totalMinor    Int

  /// Free-text note the customer left at checkout (e.g. "довжину коротше").
  note String?

  /// Куди везти. Вільний текст, а не довідник Нової Пошти: інтеграція з їхнім
  /// API — окрема робота, а приймати замовлення треба вже зараз. Коли вона
  /// зʼявиться, ці ж колонки почнуть заповнюватися вибором зі списку.
  deliveryMethod DeliveryMethod @default(NP_BRANCH)
  deliveryCity   String         @default("")
  deliveryBranch String         @default("")
  /// Одержувач, якщо він не той, хто замовляє: подарунок іншій людині —
  /// звичайна річ, а Нова Пошта видає посилку за іменем.
  recipientName  String         @default("")
  recipientPhone String         @default("")

  /// Атрибуція — та сама, що й у заявки. Без неї неможливо сказати, яка
  /// реклама принесла гроші, а не просто кліки.
  utmSource    String @default("")
  utmMedium    String @default("")
  utmCampaign  String @default("")
  utmTerm      String @default("")
  utmContent   String @default("")
  gclid        String @default("")
  landingPath  String @default("")
  referrerHost String @default("")
  sessionId    String @default("")

  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  payments Payment[]

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status, placedAt])
  @@index([utmCampaign])
}

/// One row per Monobank invoice attempt against an order. An order can have
/// more than one — the customer's card can fail and they retry — so this is
/// never folded onto Order itself.
model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  orderId   String        @db.Uuid
  provider  String        @default("monobank")
  invoiceId String        @unique
  status    PaymentStatus @default(CREATED)
  paymentType PaymentType @default(DEBIT)
  amountMinor Int
  ccy       Int           @default(980)

  /// Set only for HOLD invoices, at creation time (createdAt + 9 days —
  /// Monobank's own hold auto-cancellation window). Used as a defensive
  /// check before finalizing, not to replicate Monobank's own enforcement.
  holdExpiresAt DateTime?
  /// Set once `finalize` has been requested. Does not by itself mean the
  /// funds were captured — that is only certain once a `success` webhook
  /// arrives (see `PaymentsWebhookService`).
  finalizedAt DateTime?

  failureReason String?
  /// Full webhook payload, for support/audit. Monobank never sends a full PAN
  /// in this callback — only a masked one inside paymentInfo.
  rawWebhook Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

model OrderItem {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  variantId String @db.Uuid
  /// NULL — це базовий одяг: виріб без принта. Такий рядок цілком легальний
  /// і має нульову ціну друку. Разом із printId нульовим стає й printMethod —
  /// друкувати нічого. Обидва поля стали nullable в одній міграції; рядок,
  /// у якого одне з них NULL, а інше ні, — помилка даних.
  printId   String? @db.Uuid

  quantity    Int
  printMethod PrintMethod?

  /// Price snapshots taken at checkout. Never join to current prices to
  /// display an old order.
  garmentPriceMinor Int
  printPriceMinor   Int
  lineTotalMinor    Int

  /// What the customer was promised at the time, for MADE_TO_ORDER items.
  promisedLeadTimeDays Int?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id])
  print   Print?  @relation(fields: [printId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Orders — the "from zero" stream. Deliberately NOT an Order.
// A 16-hour design cycle is a project, not a purchase; forcing it through the
// cart is the mistake this separation exists to prevent.
// ---------------------------------------------------------------------------

model CustomRequest {
  id         String              @id @default(uuid()) @db.Uuid
  number     Int                 @unique @default(autoincrement())
  customerId String              @db.Uuid
  status     CustomRequestStatus @default(SUBMITTED)

  dogName    String
  dogBreed   String
  photoKeys  String[]
  mood       String
  references String[]
  notes      String?

  garmentType             GarmentType
  preferredLine           ProductLine?
  sizeLabel               String?
  colourNote              String?
  customerSuppliedArtwork Boolean      @default(false)
  deadline                DateTime?

  /// Filled in at QUOTED. Null before that — an unquoted request has no price.
  quotedTotalMinor      Int?
  includedRevisions     Int  @default(2)
  extraRevisionMinor    Int?
  quoteValidUntil       DateTime?

  customer Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Operational
// ---------------------------------------------------------------------------

/// Admin panel accounts. No self-registration endpoint exists — rows are
/// created only by `scripts/create-admin.mjs`, run by hand against the DB.
model AdminUser {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String
  isActive     Boolean @default(true)

  /// Per-account brute-force lockout, on top of the per-IP rate limit on
  /// /auth/login. Reset to 0 on any successful login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  /// Хто зберіг версію сторінки. `SetNull` — бо видалення адміна не має
  /// стирати історію правок разом із ним.
  pageVersions PageVersion[]
  mediaAssets  MediaAsset[]
  memberships  SiteMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Append-only. Written for every state change on an order or request so that
/// "it changed by itself" has somewhere to be looked up.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  correlationId String
  actor         String
  entity        String
  entityId      String   @db.Uuid
  action        String
  /// Never store tokens, passwords or payment credentials in here.
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Заявка з сайту. Пишеться в базу ПЕРШОЮ, і лише потім летить у Telegram —
/// заявка, що існує тільки в чаті, зникає щойно чат прокрутиться.
model Lead {
  id     String     @id @default(uuid()) @db.Uuid
  number Int        @unique @default(autoincrement())
  status LeadStatus @default(NEW)

  name    String
  phone   String
  message String?
  /// Звідки прийшла: сторінка, з якої надіслали форму.
  source  String?

  /// Атрибуція: звідки людина взагалі прийшла на сайт.
  ///
  /// Колонками, а не одним JSON, бо головне питання до цих даних —
  /// «скільки заявок дала кампанія X», а це `group by`. JSON довелося б
  /// розбирати в кожному запиті.
  utmSource    String @default("")
  utmMedium    String @default("")
  utmCampaign  String @default("")
  utmTerm      String @default("")
  utmContent   String @default("")
  /// Ідентифікатор кліку Google Ads. Без нього офлайн-конверсію не
  /// привʼязати до оголошення.
  gclid        String @default("")
  landingPath  String @default("")
  referrerHost String @default("")
  /// Той самий випадковий ідентифікатор візиту, що й у подіях.
  sessionId    String @default("")

  /// Чи долетіло в Telegram. Null означає «не долетіло» — видно в адмінці,
  /// а не тільки в логах.
  telegramSentAt DateTime?
  telegramError  String?

  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])

  correlationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([phone])
  @@index([status, createdAt])
  @@index([telegramSentAt])
  @@index([utmCampaign])
}
