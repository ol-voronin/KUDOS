# --- API ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://dt:dt_local_only@localhost:5432/doggietale?schema=public
# Пряме зʼєднання для міграцій. Локально — те саме, що DATABASE_URL.
# У Neon: DATABASE_URL — пулований (-pooler у хості), DIRECT_DATABASE_URL — без пулу.
DIRECT_DATABASE_URL=postgresql://dt:dt_local_only@localhost:5432/doggietale?schema=public

# Secrets: generate per environment, never commit real values.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=__replace_me__
JWT_REFRESH_SECRET=__replace_me__
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Comma-separated allowlist. No wildcards in production.
CORS_ORIGINS=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Публічна адреса сайту — потрібна для sitemap.xml, robots.txt і canonical.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Куди Next переписує /api/* (браузер туди не ходить напряму — див. api-origin.ts).
API_ORIGIN=http://localhost:4000
# Абсолютна адреса API для серверних компонентів Next.
API_INTERNAL_URL=http://localhost:4000/api/v1

# --- Telegram ---
# 1. @BotFather -> /newbot -> отримаєш токен
# 2. Додай бота в групу (або напиши йому в особисті)
# 3. Відкрий https://api.telegram.org/bot<ТОКЕН>/getUpdates і візьми chat.id
TELEGRAM_BOT_TOKEN=
# Число (група/особисті) або @channelname, якщо це публічний канал і бот там адмін.
TELEGRAM_CHAT_ID=

# --- Monobank (Acquiring) ---
# Бойовий токен: https://web.monobank.ua/ (особистий кабінет ФОП)
# Тестовий токен (без термінала, працює для будь-якого клієнта банку): https://api.monobank.ua/
MONOBANK_TOKEN=__replace_me__
# Публічні базові адреси — потрібні лише для оплати готовими принтами:
# WEB_PUBLIC_URL -> куди Monobank поверне браузер клієнта після оплати (redirectUrl)
# API_PUBLIC_URL -> куди Monobank надішле вебхук про статус оплати (webHookUrl)
# На localhost жодна з них не досяжна ззовні — Monobank не зможе постукати назад,
# поки апі не задеплоєно з публічною адресою.
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
